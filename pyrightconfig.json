{
    "typeCheckingMode": "basic",
    "pythonVersion": "3.12",
    "pythonPlatform": "Linux",
    "extraPaths": [
        "login_service"
    ],
    "include": [
        "features",
        "tests",
        "tools",
        "login_service",
        "ZAH.py"
    ],
    "exclude": [
        "ZAH_Legacy",
        ".venv",
        "ZeroGBridge",
        ".scratchpad",
        "**/bin",
        "**/__pycache__"
    ],
    "executionEnvironments": [
        {
            "root": "tests",
            "extraPaths": [
                ".",
                "login_service"
            ],
            "reportOptionalMemberAccess": "none",
            "reportOptionalSubscript": "none"
        },
        {
            "root": "."
        }
    ]
}
