<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ZeroGBridge</AssemblyName>
    <RootNamespace>ZeroGBridge</RootNamespace>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <!-- Assembly Metadata Attributes -->
    <Title>ZeroGBridge</Title>
    <Description>ZeroGBridge hot-reload loader (stable mod entry point; loads Core/ZeroGBridge.Core.dll)</Description>
    <Company>Zero-G Forge</Company>
    <Product>ZeroGBridge</Product>
    <Copyright>Copyright © 2026 Zero-G Forge</Copyright>
    <AssemblyTrademark>ZGB</AssemblyTrademark>

    <!-- Dynamic 16-bit Valid UTC-5 (CDT) Version Generation -->
    <MajorVersion>1</MajorVersion>
    <MinorVersion>5</MinorVersion>
    <!-- Human release name (1.5.0). The numeric version stays Major.Minor.MMDD.HHmm. -->
    <ReleaseVersion>1.5.0</ReleaseVersion>
    <BuildDate>$([System.DateTime]::UtcNow.AddHours(-5).ToString("MMdd"))</BuildDate>
    <BuildTime>$([System.DateTime]::UtcNow.AddHours(-5).ToString("HHmm"))</BuildTime>

    <Version>$(MajorVersion).$(MinorVersion).$(BuildDate).$(BuildTime)</Version>
    <AssemblyVersion>$(MajorVersion).$(MinorVersion).$(BuildDate).$(BuildTime)</AssemblyVersion>
    <FileVersion>$(MajorVersion).$(MinorVersion).$(BuildDate).$(BuildTime)</FileVersion>
    <InformationalVersion>$(ReleaseVersion)+$(MajorVersion).$(MinorVersion).$(BuildDate).$(BuildTime)</InformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);lib/.EmpyrionAPITools-0-10.0/**;**/.EmpyrionAPITools-0-10.0/**;CoreProject/**</DefaultItemExcludes>
    <!-- 1.5.0: this project is the LOADER only (the DLL Empyrion loads). Bridge logic (Core/, Network/,
         Logging/) is built by CoreProject/ZeroGBridge.Core.csproj into the reloadable core DLL. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Loader/**/*.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="ModApi">
      <HintPath>lib/ModApi.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- GlobalStructureInfo (IApplication.GetStructures) lives in Mif.dll; the game ships it. -->
    <Reference Include="Mif">
      <HintPath>lib/Mif.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Newtonsoft.Json">
      <HintPath>lib/Additional Libs/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <Reference Include="Mono.Data.Sqlite">
    <HintPath>lib/Additional Libs/Mono.Data.Sqlite.dll</HintPath>
    <Private>false</Private>
    </Reference>
    <Reference Include="System.Data" />

    <Reference Include="UnityEngine.CoreModule">
      <HintPath>lib/Additional Libs/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>


  <ItemGroup>
    <None Update="ZeroGBridge.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Auto-generate matching ModInfo.yaml on build -->
  <Target Name="GenerateModInfoYaml" AfterTargets="Build">
    <PropertyGroup>
      <ModInfoContent>Name: ZeroGBridge%0ADisplayName: ZeroGBridge%0AVersion: $(Version)%0AAuthor: Zero-G Forge%0ADescription: Dedicated Telemetry &amp; Administration Bridge for Empyrion (hot-reload loader $(ReleaseVersion)%3B core in Core/ZeroGBridge.Core.dll)</ModInfoContent>
    </PropertyGroup>
    <WriteLinesToFile 
      File="$(TargetDir)ModInfo.yaml" 
      Lines="$(ModInfoContent)" 
      Overwrite="true" />
  </Target>

</Project>