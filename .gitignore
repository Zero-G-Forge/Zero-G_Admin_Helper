# =====================================================================
# Zero-G Admin Helper (ZAH) - the one ignore file for this repo
# Applies to the whole repo, including ZAH_Legacy/.
# =====================================================================

# region: Python
.venv/
__pycache__/
*.py[cod]
# endregion

# region: Editors
.vscode/
.vs/
# endregion

# region: Local data and secrets (never pushed)
# data/ holds server_config.json (bridge token) and owner_login.json (owner password hash).
data/
data/server_config.json
data/owner_login.json
git_token.txt
# Every .json is local by default; the exceptions below are tracked on purpose.
*.json
!ZeroGBridge/ZeroGBridge.json
!.instructions/Examples/**/*.json
!.instructions/.markdownlint.json
# endregion

# region: Scratch and AI notes
*.scratchpad/
AI_INSTRUCTIONS.md
# endregion

# region: ZeroGBridge (C#) build files
# bin/ is tracked on purpose (built mod files); obj/ and user files are not.
!ZeroGBridge/bin/
ZeroGBridge/obj/
ZeroGBridge/CoreProject/obj/
ZeroGBridge/tests/ServerFilesTest/bin/
ZeroGBridge/tests/ServerFilesTest/obj/
*.user
*.suo
*.csproj.user
# endregion

# region: Legacy ZAH (kept from the original ignore file)
# Original rules for the legacy program; most are now covered by the sections above.
!data/*.py
!.instruction/
!.instruction/README.md
ZAH_Legacy/.zah_restart.log
# endregion
